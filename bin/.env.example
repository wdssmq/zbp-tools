# Copy this file to .env and adjust all paths for the local machine.
ZBP17_WORKTREE=/path/to/zblogphp
ZBP17_WEB_ROOT=/path/to/wwwroot/zbp17

ZBP18_WORKTREE=/path/to/zblogphp.worktrees/dev-zbp18
ZBP18_WEB_ROOT=/path/to/wwwroot/zbp18

ZBP_ARCHIVE_DIR=/path/to/archives

ZBP_SITE_NAME='Z-BlogPHP Test Site'
ZBP_ADMIN_USER=admin
ZBP_ADMIN_PASSWORD=''

ZBP_MYSQL_TYPE=pdo_mysql
ZBP_MYSQL_SERVER=127.0.0.1
ZBP_MYSQL_PORT=3306
ZBP_MYSQL_DATABASE=zbp
ZBP_MYSQL_USER=root
ZBP_MYSQL_PASSWORD=''
ZBP_MYSQL_PREFIX=zbp_
ZBP_MYSQL_ENGINE=MyISAM

# 外部插件源路径数组，格式: "源目录:目标插件名"
# 例如: ZBP_PLUGIN_SOURCES=("/path/to/zbp_UEditor/UEditor:UEditor")
ZBP_PLUGIN_SOURCES=()